#!/usr/bin/env bash
# Block pushes that change Lamdera types without a committed Evergreen migration.
#
# `lamdera check` compiles the project and type-checks it against the *deployed*
# production app. It exits non-zero when the project doesn't compile, or when a
# persisted type changed since the last deploy and no migration is committed
# (it generates src/Evergreen/V<N>/ + Migrate/V<N>.elm with `Unimplemented`
# placeholders). We turn that exit code into a push gate so a missing migration
# is caught at PR time instead of blowing up at deploy.
#
# It also runs scripts/evergreen-version-check.sh first: every deploy bumps
# production's version, so a migration numbered against an older deploy is
# stale, and lamdera check alone can't tell (see that script).
#
# scripts/lamdera-check.sh handles linked worktrees (Conductor workspaces) and
# lamdera's "Shall I run git add?" prompt.
#
# Bypass (e.g. offline, not logged in, or a deliberate WIP push):
#   git push --no-verify
#
# See .claude/skills/lamdera-deploy/SKILL.md for the full workflow.

set -euo pipefail

toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"

# Only spend the compile when the push actually changes Elm source — a type
# change can come from any module reachable from the model, not just Types.elm.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
#
# Scope against the merge-base with trunk (not the branch's remote tip): we care
# what this branch changes *relative to origin/main*. Using the remote tip would
# sweep in trunk's own Elm commits after a rebase or when the branch is behind,
# triggering the check on changes that aren't this branch's.
elm_touched=0
pushing_non_head_elm=0
head_sha=$(git rev-parse HEAD)
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    # Branch deletion (local sha all-zeros): nothing to check.
    [[ "$local_sha" =~ ^0+$ ]] && continue

    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    if [ -z "$base" ]; then
        # Couldn't determine a range — fail safe and run the check.
        elm_touched=1
    elif git diff --name-only "$base" "$local_sha" 2>/dev/null | grep -qE '^src/.*\.elm$'; then
        elm_touched=1
    else
        continue
    fi
    # lamdera check can only validate the working tree (HEAD). If the ref we're
    # pushing isn't the current checkout, validating HEAD would gate the wrong
    # commit, so refuse rather than pass on unverified code.
    [ "$local_sha" = "$head_sha" ] || pushing_non_head_elm=1
done

if [ "$elm_touched" -eq 0 ]; then
    exit 0
fi

if [ "$pushing_non_head_elm" -eq 1 ]; then
    {
        echo ""
        echo "pre-push: pushing a ref with Elm changes that isn't your current checkout."
        echo ""
        echo "  'lamdera check' can only validate the checked-out commit (HEAD), so it"
        echo "  can't verify the migration state of the ref you're pushing. Check out"
        echo "  that branch/commit and push from there so the same commit is validated."
        echo ""
        echo "  Deliberate?  git push --no-verify"
    } >&2
    exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD)

# Freshness: a feature branch forked from stale trunk can pass its own check yet
# leave main needing a migration once merged — its Evergreen snapshot was built
# against an out-of-date base (this is the squash-merge trap). Require the latest
# origin/main to be an ancestor of what we're pushing, so the migration chains
# off the current version. (Skipped on main itself — that's the deploy's job.)
# A deploy that lands after this push makes the migration stale anyway; the
# version check below and CI (re-run after every deploy) catch that.
if [ "$branch" != "main" ] && [ "$branch" != "master" ]; then
    if git fetch --quiet origin main 2>/dev/null; then
        if ! git merge-base --is-ancestor origin/main HEAD; then
            {
                echo ""
                echo "pre-push: branch is behind origin/main — refusing to push."
                echo ""
                echo "  Any migration here would be computed against a stale trunk, so"
                echo "  main could still need a migration after this merges. Update first:"
                echo "    git fetch origin && git merge origin/main   # (or rebase)"
                echo "  then push again."
                echo ""
                echo "  Deliberate?  git push --no-verify"
            } >&2
            exit 1
        fi
    else
        echo "pre-push: couldn't fetch origin/main — skipping freshness check." >&2
    fi
fi

# Stale migration numbers. Needs no Lamdera login, so it runs everywhere.
# Offline is a warning only: CI runs the same check on the PR.
git fetch --quiet origin deployed 2>/dev/null || true
version_status=0
scripts/evergreen-version-check.sh || version_status=$?
if [ "$version_status" -eq 1 ]; then
    echo "pre-push: refusing to push a stale Evergreen migration (see above)." >&2
    echo "  Deliberate?  git push --no-verify" >&2
    exit 1
elif [ "$version_status" -ne 0 ]; then
    echo "pre-push: couldn't check Evergreen version numbers — skipping (CI enforces it)." >&2
fi

# Cloud sessions (claude.ai/code) without the LAMDERA_CLI_AUTH environment
# secret can't run `lamdera check`. Don't force --no-verify there: CI
# (tests.yml) runs the same check on the PR.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ] && [ ! -s "${ELM_HOME:-$HOME/.elm}/.lamdera-cli" ]; then
    echo "pre-push: no Lamdera CLI auth in this cloud session — skipping 'lamdera check' (CI enforces it on the PR)." >&2
    exit 0
fi

check_status=0
scripts/lamdera-check.sh || check_status=$?
if [ "$check_status" -eq 3 ]; then
    # Passed, but against Evergreen files that aren't in the commit being pushed.
    echo "pre-push: commit src/Evergreen, then push again." >&2
    exit 1
elif [ "$check_status" -ne 0 ]; then
    {
        echo ""
        echo "pre-push: 'lamdera check' failed — refusing to push."
        echo ""
        echo "  'types have changed since last deploy (vN)' and it generated"
        echo "  src/Evergreen/Migrate/V<N+1>.elm? If this branch already has an older"
        echo "  src/Evergreen/V<k> of its own, that one is stale: don't finish the new"
        echo "  file, run scripts/regen-migration.sh instead."
        echo ""
        echo "  Otherwise finish src/Evergreen/Migrate/V<N+1>.elm (replace any"
        echo "  Unimplemented), commit src/Evergreen, and push again."
        echo ""
        echo "  Compile error?  Fix it."
        echo "  Offline / not logged in / deliberate WIP?  git push --no-verify"
        echo ""
        echo "  See .claude/skills/lamdera-deploy/SKILL.md"
    } >&2
    exit 1
fi
